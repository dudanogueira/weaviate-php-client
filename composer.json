{
    "name": "dudanogueira/weaviate-php-client",
    "description": "PHP client for the Weaviate vector database: gRPC-first, with feature parity to the Python v4 client.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "weaviate",
        "vector-database",
        "vector-search",
        "grpc",
        "rag",
        "hybrid-search"
    ],
    "homepage": "https://github.com/dudanogueira/weaviate-php-client",
    "support": {
        "issues": "https://github.com/dudanogueira/weaviate-php-client/issues",
        "source": "https://github.com/dudanogueira/weaviate-php-client",
        "docs": "https://github.com/dudanogueira/weaviate-php-client/tree/main/docs"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "google/protobuf": "^5.35",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "ext-grpc": "Enables the ExtGrpcTransport, including bidirectional streaming for server-side batching",
        "ext-protobuf": "Faster protobuf encoding and decoding than the pure-PHP runtime"
    },
    "autoload": {
        "psr-4": {
            "Weaviate\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weaviate\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
